{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sast-code-audit-skill.github.io/schemas/v1/final-result.schema.json",
  "title": "SAST Audit Final Result",
  "description": "Authoritative merged report at .sast/results.json produced by stage 5 of the sast-code-audit skill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "summary", "vulnerabilities", "false_positives"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "scan_time", "scope", "generator", "skill_version"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "scan_time": { "type": "string", "format": "date-time" },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "Audited directories/files and anything explicitly excluded."
        },
        "generator": { "const": "sast-code-audit" },
        "skill_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "total"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "vulnerabilities": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "vulnerability.schema.json" },
          {
            "properties": {
              "review_status": { "enum": ["confirmed", "updated"] }
            }
          }
        ]
      }
    },
    "false_positives": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "vulnerability.schema.json" },
          {
            "properties": {
              "review_status": { "const": "false_positive" }
            }
          }
        ]
      }
    }
  }
}
