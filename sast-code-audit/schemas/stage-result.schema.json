{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sast-code-audit-skill.github.io/schemas/v1/stage-result.schema.json",
  "title": "SAST Audit Stage Result",
  "description": "Envelope for stage artifacts .sast/results/VULN_LCSR_1.json .. VULN_LCSR_4.json of the sast-code-audit skill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generator",
    "skill_version",
    "stage",
    "stage_name",
    "generated_at",
    "vulnerabilities"
  ],
  "properties": {
    "generator": { "const": "sast-code-audit" },
    "skill_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver of the skill that produced this artifact."
    },
    "stage": { "type": "integer", "minimum": 1, "maximum": 4 },
    "stage_name": {
      "enum": ["reconnaissance", "exploration", "checklist", "review"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with timezone offset."
    },
    "project_profile": { "$ref": "#/$defs/project_profile" },
    "vulnerabilities": {
      "type": "array",
      "items": { "$ref": "vulnerability.schema.json" }
    },
    "checklist_coverage": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "status"],
        "properties": {
          "category": {
            "enum": [
              "injection",
              "files-paths",
              "request-network",
              "auth-session",
              "authorization",
              "deserialization",
              "business-logic",
              "data-exposure",
              "client-side",
              "dependencies-config"
            ]
            },
          "status": {
            "enum": ["vulnerable", "clean", "not_applicable"],
            "description": "vulnerable = stage 3 itself added a finding in this category; clean = checked, nothing new; not_applicable = stack has no such surface."
          },
          "note": {
            "type": "string",
            "description": "Short justification, e.g. cross-reference to a stage 2 finding that already covers the category."
          }
        }
      }
    }
  },
  "$defs": {
    "project_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "frameworks",
        "auth_model",
        "entrypoints",
        "trust_boundaries"
      ],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string" }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string" }
            }
          }
        },
        "security_libs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string" },
              "role": {
                "type": "string",
                "description": "What it defends: validation, escaping, authn, authz, crypto, ..."
              }
            }
          }
        },
        "sanitization_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Existing defense patterns with their location, e.g. 'zod schemas in src/validators/*.js'."
        },
        "auth_model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": { "type": "string", "minLength": 1 },
            "mechanisms": { "type": "array", "items": { "type": "string" } }
          }
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "location", "description", "auth_required"],
            "properties": {
              "type": {
                "enum": ["http", "https", "grpc", "rpc", "ws", "cli", "cron", "mq", "job"]
              },
              "location": { "type": "string", "pattern": "^.+:\\d+$" },
              "description": { "type": "string", "minLength": 1 },
              "auth_required": { "type": "boolean" }
            }
          }
        },
        "trust_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["boundary", "enforcement", "location"],
            "properties": {
              "boundary": {
                "type": "string",
                "minLength": 1,
                "description": "e.g. 'Internet -> API', 'user -> tenant data'."
              },
              "enforcement": {
                "type": "string",
                "minLength": 1,
                "description": "What enforces the boundary, or 'none' when it is missing."
              },
              "location": { "type": "string", "pattern": "^.+:\\d+$" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "stage": { "const": 1 } },
        "required": ["stage"]
      },
      "then": {
        "required": ["project_profile"],
        "properties": {
          "stage_name": { "const": "reconnaissance" },
          "vulnerabilities": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "stage": { "const": 2 } },
        "required": ["stage"]
      },
      "then": {
        "properties": { "stage_name": { "const": "exploration" } }
      }
    },
    {
      "if": {
        "properties": { "stage": { "const": 3 } },
        "required": ["stage"]
      },
      "then": {
        "required": ["checklist_coverage"],
        "properties": { "stage_name": { "const": "checklist" } }
      }
    },
    {
      "if": {
        "properties": { "stage": { "const": 4 } },
        "required": ["stage"]
      },
      "then": {
        "properties": { "stage_name": { "const": "review" } }
      }
    },
    {
      "if": {
        "properties": { "stage": { "enum": [2, 3] } },
        "required": ["stage"]
      },
      "then": {
        "properties": {
          "vulnerabilities": {
            "items": {
              "properties": {
                "review_status": { "const": "pending_review" }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "stage": { "const": 4 } },
        "required": ["stage"]
      },
      "then": {
        "properties": {
          "vulnerabilities": {
            "items": {
              "properties": {
                "review_status": { "enum": ["confirmed", "updated", "false_positive"] }
              }
            }
          }
        }
      }
    }
  ]
}
